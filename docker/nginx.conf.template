server {
    listen 8080;
    server_name _;
    access_log off;
    error_log /dev/stderr warn;
    client_max_body_size 4m;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /mcp {
        proxy_pass http://host.docker.internal:18765/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host "127.0.0.1:18765";
        proxy_set_header Authorization "Bearer ${WECHAT_BRIDGE_TOKEN}";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        return 404;
    }
}
